{
  extends: ["helpers:pinGitHubActionDigests"],
  schedule: [
    'before 5am on the first day of the month',
  ],
  minimumReleaseAge: '3 days',
  minimumReleaseAgeBehaviour: 'timestamp-required',
  internalChecksFilter: 'strict',
  semanticCommits: 'enabled',
  commitMessageLowerCase: 'never',
  configMigration: true,
  dependencyDashboard: true,
  "pre-commit": {
    enabled: true
  },
  customManagers: [
    {
      // Renovate has no datasource for a dated nightly, so read the date from
      // the nightly Rust entry in mise.toml and offer the custom datasource below.
      customType: 'regex',
      managerFilePatterns: [
        '/^mise\\.toml$/',
      ],
      matchStrings: [
        '\\{ version = "nightly-(?<currentValue>\\d{4}-\\d{2}-\\d{2})"',
      ],
      depNameTemplate: 'rust-nightly',
      datasourceTemplate: 'custom.rust-nightly',
      versioningTemplate: 'regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})$',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Cargo\\.toml$/',
        '/^\\.pre-commit-config\\.yaml$/',
        '/^\\.github/workflows/(audit|pre-commit)\\.yaml$/',
        '/^mise(\\.ci)?\\.toml$/',
      ],
      matchStrings: [
        'rust-version\\s*=\\s*"(?<currentValue>\\d+\\.\\d+\\.\\d+)"',
        'RUSTUP_TOOLCHAIN(:|\\s*=)\\s*"(?<currentValue>\\d+\\.\\d+\\.\\d+)"',
        // The MSRV entry in mise.toml's Rust list; the leading newline keeps
        // the `"cargo:…" = { version = … }` tool entries out.
        '\\n\\s+\\{ version = "(?<currentValue>\\d+\\.\\d+\\.\\d+)"',
        'rust:\\s*"(?<currentValue>\\d+\\.\\d+\\.\\d+)"',
      ],
      depNameTemplate: 'rust-msrv',
      packageNameTemplate: 'rust',
      datasourceTemplate: 'rust-version',
      versioningTemplate: 'rust-release-channel',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/pre-commit\\.yaml$/',
      ],
      matchStrings: [
        'prek-version.*?(?<currentValue>\\d+\\.\\d+(\\.\\d+)?)',
      ],
      depNameTemplate: 'prek',
      packageNameTemplate: 'j178/prek',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/actions/setup-rust/action\\.yaml$/',
      ],
      matchStrings: [
        'version:\\s*"(?<currentValue>\\d+\\.\\d+\\.\\d+)"\\s*# MISE_VERSION',
      ],
      depNameTemplate: 'mise',
      packageNameTemplate: 'jdx/mise',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
  ],
  customDatasources: {
    // The newest nightly that ships rustfmt; some nightlies lack it.
    'rust-nightly': {
      defaultRegistryUrlTemplate: 'https://rust-lang.github.io/rustup-components-history/x86_64-unknown-linux-gnu/rustfmt.json',
      format: 'json',
      transformTemplates: [
        '{ "releases": [{ "version": last_available }] }',
      ],
    },
  },
  packageRules: [
    {
      // Nightlies release daily; a weekly bump keeps the pinned toolchain
      // ahead of the latest beta without the churn (and breakage risk) of
      // tracking every nightly.
      commitMessageTopic: 'Rust toolchain',
      matchManagers: [
        'custom.regex',
      ],
      matchDepNames: [
        'rust-nightly',
      ],
      schedule: [
        'before 5am on Monday',
      ],
      minimumReleaseAge: null,
      automerge: true,
    },
    {
      commitMessageTopic: 'Rust MSRV',
      matchManagers: [
        'custom.regex',
      ],
      matchDepNames: [
        'rust-msrv',
      ],
      allowedVersions: '/^\\d+\\.\\d+\\.\\d+$/',
      schedule: [
        '* * * * *',
      ],
      minimumReleaseAge: null,
      automerge: true,
    },
    {
      commitMessageTopic: 'Mise',
      matchManagers: [
        'custom.regex',
      ],
      matchDepNames: [
        'mise',
      ],
      schedule: [
        '* * * * *',
      ],
      minimumReleaseAge: null,
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'compatible (actions)',
    },
    {
      // The rust-nightly custom manager updates the pinned nightly.
      matchManagers: [
        'mise',
      ],
      matchDepNames: [
        'rust',
      ],
      enabled: false,
    },
    {
      matchManagers: [
        'mise',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'compatible (mise)',
    },
    {
      commitMessageTopic: 'Prek',
      matchPackageNames: [
        'j178/prek',
      ],
      extractVersion: '^v(?<version>\\d+\\.\\d+\\.\\d+)',
      schedule: [
        '* * * * *',
      ],
      groupName: 'Prek',
    },
    {
      matchPackageNames: [
        'crate-ci/committed',
      ],
      groupName: 'committed',
    },
    // Goals:
    // - Keep version reqs low, ignoring compatible normal/build dependencies
    // - Take advantage of latest dev-dependencies
    // - Rollup safe upgrades to reduce CI runner load
    // - Help keep number of versions down by always using latest breaking change
    // - Have lockfile and manifest in-sync
    {
      matchManagers: [
        'cargo',
      ],
      matchDepTypes: [
        'build-dependencies',
        'dependencies',
      ],
      matchCurrentVersion: '>=0.1.0',
      matchUpdateTypes: [
        'patch',
      ],
      enabled: false,
    },
    {
      matchManagers: [
        'cargo',
      ],
      matchDepTypes: [
        'build-dependencies',
        'dependencies',
      ],
      matchCurrentVersion: '>=1.0.0',
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      enabled: false,
    },
    {
      matchManagers: [
        'cargo',
      ],
      matchDepTypes: [
        'dev-dependencies',
      ],
      matchCurrentVersion: '>=0.1.0',
      matchUpdateTypes: [
        'patch',
      ],
      groupName: 'compatible (dev)',
    },
    {
      matchManagers: [
        'cargo',
      ],
      matchDepTypes: [
        'dev-dependencies',
      ],
      matchCurrentVersion: '>=1.0.0',
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'compatible (dev)',
    },
  ],
}
